<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Godot .NET SDK and GodotSharp come from nuget.org. The root
       NuGet.config's local GodotLocal source was an artifact of an old build
       environment and no longer exists, so clear it here. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
